#!/usr/bin/env python3
from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parent
args = list(sys.argv[1:])
if "--profile" not in args:
    args = ["--profile", "portable", *args]
proc = subprocess.run([sys.executable, "-S", str(root / "tools/check_dependency_lockfiles.py"), *args], cwd=root)
# Exit 2 is the explicit portable LOCK_GENERATOR_UNAVAILABLE SKIP. The direct
# policy checker treats that as a satisfied check-with-exception; release_gate
# preserves it as SKIP in canonical result accounting.
raise SystemExit(0 if proc.returncode == 2 and "portable" in args else proc.returncode)
